import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

url = "https://raw.githubusercontent.com/sudarshan-koirala/Salary-Prediciton-based-on-Years-of-Experience/master/Salary_Data.csv"
df = pd.read_csv(url)
print(df)

x = df['YearsExperience'].values
y = df['Salary'].values

print(x)
print(y)

sum_x = sum(x)
sum_y = sum(y)
sum_xy = 0
sum_x2 = 0
n = len(x)

for i in range(len(x)):
  sum_xy+=x[i] * y[i]
  sum_x2+=x[i]**2
print(sum_xy)

m = (n*sum_xy - sum_x * sum_y)/(n*sum_x2 - sum_x * sum_x)
print(m)

c =  (sum_y - m*sum_x)/n
print(c)

y_pred  = []
count = 0
for i in range(len(x)):
  y_pred.append(m*x[i] + c)
  count+=1
print(y_pred)
print(count)
plt.scatter(x, y, color='blue', label='Actual data')
plt.plot(x, y_pred, color='red', label=f'y = {m:.2f}x + {c:.2f}')
plt.xlabel('X')
plt.ylabel('Y')
plt.title('Linear Regression Fit')
plt.legend()
plt.grid(True)

plt.show()

